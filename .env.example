DATABASE_URL=postgresql://user:password@localhost:5432/coco
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000

# Base64-encoded 32-byte key used to encrypt staff TOTP secrets at rest.
# Generate once and keep stable in production, e.g. openssl rand -base64 32
STAFF_MFA_ENCRYPTION_KEY=

BLOB_READ_WRITE_TOKEN=

# Resend transactional email. New registration is paused until both are set.
RESEND_API_KEY=
EMAIL_FROM=CoCo <noreply@example.com>


# Preview-only test users.
# Use a database dedicated to Vercel Preview. Never reuse the production DATABASE_URL.
# In Preview, set DATABASE_URL and PREVIEW_DATABASE_URL to the same Preview database URL.
PREVIEW_SEED_USERS=0
PREVIEW_DATABASE_URL=
PREVIEW_TEST_PASSWORD=

# Staff roles are managed explicitly from the ADMIN user-management interface.
