  cgiS             Int?
  q1               Int
  q2               Int
  q3               Int
  q4               Int
  q5               Int
  q6               Int
  q7               Int
  q8               Int
  q9               Int
  q10              Int
  symptomsCurrent  String[]
  symptomsPast     String[]

  user User @relation(fields: [userId], references: [id])
}

