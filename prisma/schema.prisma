// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String               @id @default(cuid())
  email                   String               @unique
  emailVerifiedAt         DateTime?
  password                String
  name                    String?
  bio                     String?
  avatarUrl               String?
  headerUrl               String?
  autoHashtag             String?
  isPrivate               Boolean              @default(false)
  role                    Role                 @default(USER)
  status                  AccountStatus        @default(ACTIVE)
  restrictionReason       String?
  suspendedUntil          DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  posts                   Post[]
  likes                   Like[]
  bookmarks               Bookmark[]
  following               Follow[]             @relation("UserFollowing")
  followers               Follow[]             @relation("UserFollowers")
  notificationsReceived   Notification[]       @relation("NotificationRecipient")
  notificationsSent       Notification[]       @relation("NotificationActor")
  ybocsResults            YbocsResult[]
  iesrResults             IesrResult[]
  itqResults              ItqResult[]
  lsasResults             LsasResult[]
  replies                 Reply[]
  reactions               Reaction[]
  blocksInitiated         Block[]              @relation("UserBlocks")
  blockedBy               Block[]              @relation("UserBlockedBy")
  mutesInitiated          Mute[]               @relation("UserMutes")
  mutedBy                 Mute[]               @relation("UserMutedBy")
  actorLogs               AuditLog[]           @relation("ActorLogs")
  targetLogs              AuditLog[]           @relation("TargetLogs")
  reportsMade             Report[]             @relation("ReportsMade")
  reportsTargetingUser    Report[]             @relation("ReportsTargetUser")
  reportsReviewed         Report[]             @relation("ReportsReviewed")
  reportsAssigned         Report[]             @relation("ReportsAssigned")
  hiddenPosts             Post[]               @relation("PostHiddenBy")
  announcementsCreated    Announcement[]       @relation("AnnouncementsCreated")
  adminNotesAuthored      AdminNote[]          @relation("AdminNotesAuthored")
  adminNotesTargetingUser AdminNote[]          @relation("AdminNotesTargetUser")
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model Post {
  id            String         @id @default(cuid())
  content       String
  imageUrl      String?
  createdAt     DateTime       @default(now())
  wakaruCount   Int            @default(0)
  ganbattaCount Int            @default(0)
  authorId      String
  author        User           @relation(fields: [authorId], references: [id])
  quotePostId   String?
  quotePost     Post?          @relation("QuotePost", fields: [quotePostId], references: [id])
  quotedBy      Post[]         @relation("QuotePost")
  isHidden      Boolean        @default(false)
  hiddenAt      DateTime?
  hiddenReason  String?
  hiddenById    String?
  deletedAt     DateTime?
  deletedById   String?
  hiddenBy      User?          @relation("PostHiddenBy", fields: [hiddenById], references: [id])
  likes         Like[]
  bookmarks     Bookmark[]
  notifications Notification[]
  replies       Reply[]
  reactions     Reaction[]
  reports       Report[]       @relation("PostReports")

  @@index([deletedAt, createdAt])
  @@index([authorId, deletedAt, createdAt])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id])
  following   User     @relation("UserFollowers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

enum NotificationType {
  LIKE
  FOLLOW
  WAKARU
  GANBATTA
}

enum ReactionType {
  WAKARU
  GANBATTA
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  POST_RESTRICTED
  SUSPENDED
}

enum ReportReason {
  HARASSMENT
  SPAM
  IMPERSONATION
  SELF_HARM
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

enum ReportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  userId    String
  actorId   String
  postId    String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id])
  actor User  @relation("NotificationActor", fields: [actorId], references: [id])
  post  Post? @relation(fields: [postId], references: [id])
}

