model Reply {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  authorId  String
  postId    String

  author User @relation(fields: [authorId], references: [id])
  post   Post @relation(fields: [postId], references: [id])
}

model Reaction {
  id        String       @id @default(cuid())
  type      ReactionType
  createdAt DateTime     @default(now())
  userId    String
  postId    String

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId, type])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("UserBlocks", fields: [blockerId], references: [id])
  blocked User @relation("UserBlockedBy", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

model Mute {
  id        String   @id @default(cuid())
  muterId   String
  mutedId   String
  createdAt DateTime @default(now())

  muter User @relation("UserMutes", fields: [muterId], references: [id])
  muted User @relation("UserMutedBy", fields: [mutedId], references: [id])

  @@unique([muterId, mutedId])
}

model AuditLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  action       String
  meta         Json
  actorUserId  String
  targetUserId String

  actorUser  User @relation("ActorLogs", fields: [actorUserId], references: [id])
  targetUser User @relation("TargetLogs", fields: [targetUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
}
